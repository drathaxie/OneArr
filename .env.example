# Copy to .env (never commit .env). No real credentials belong in this file.
# TMDb key: optional at runtime; you can also enter it in Settings. Use a key you created yourself.
ONEARR_TMDB_API_KEY=
# Host interface for the published port. Keep 127.0.0.1 unless behind an authenticated TLS proxy.
ONEARR_BIND=127.0.0.1
# Host folder mounted at /data (must contain torrents/ and media/ subfolders for imports).
ONEARR_DATA_DIR=./data
